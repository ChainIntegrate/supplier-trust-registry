PORT=3010
FRONTEND_URL=https://supplier-trust-registry.chainintegrate.it

# RPC LUKSO — stesso provider gia' in uso per MatchPredictor v3
LUKSO_RPC_URL=https://42.rpc.thirdweb.com/REPLACE_WITH_CLIENT_ID
LUKSO_CHAIN_ID=42

# Indirizzo del contratto SupplierRegistry, dopo il deploy
REGISTRY_CONTRACT_ADDRESS=

# Pinata — Files API v3, JWT con permessi di upload (mai il frontend, solo qui)
PINATA_JWT=

# Firma dei token di sessione emessi dopo verifica firma UP (30 min di validita')
JWT_SECRET=            # 64 byte hex, come negli altri progetti ChainIntegrate

# Limite dimensione file per singolo upload (byte). 10 MB e' pensato per
# documenti veri (feature Gold); il JSON di valutazione/nome fornitore resta
# comunque piccolo indipendentemente da questo tetto.
MAX_UPLOAD_BYTES=10485760

# Sotto questa soglia, qualunque tier puo' caricare senza controlli extra.
# Sopra, il server verifica on-chain che l'indirizzo sia Gold prima di
# accettare l'upload (non solo un limite mostrato lato interfaccia).
FREE_UPLOAD_BYTES=307200
