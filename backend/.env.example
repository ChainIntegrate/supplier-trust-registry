PORT=3011
FRONTEND_URL=https://supplier-trust-registry.chainintegrate.it

# RPC LUKSO mainnet (chain 42) usato dal backend e dal proxy /api/rpc.
# Il nodo proprio, con il suo token nell'URL: resta solo qui, mai nel frontend.
LUKSO_RPC_URL=
LUKSO_CHAIN_ID=42

# Indirizzo del contratto SupplierRegistry V3 (mainnet)
REGISTRY_CONTRACT_ADDRESS=0xFa143308D85b81Ed57547049F4A7718c3117A064

# Facoltativo. Il proxy /api/rpc accetta letture (eth_call, eth_getLogs)
# SOLO verso REGISTRY_CONTRACT_ADDRESS. Se in futuro il frontend dovesse
# leggere anche altri contratti (es. Membership), elencarli qui separati
# da virgola.
RPC_EXTRA_ALLOWED_ADDRESSES=

# API di scrittura del nodo IPFS (Kubo, porta 5001), raggiungibile solo
# dall'IP di questo VPS. Solo l'indirizzo base, es. http://<ip-nodo>:5001
# (stessa variabile di traceability-registry).
IPFS_API_URL=

# Firma dei token di sessione emessi dopo verifica firma UP (30 min di validita')
JWT_SECRET=            # 64 byte hex, come negli altri progetti ChainIntegrate

# Limite dimensione file per singolo upload (byte). 10 MB e' pensato per
# documenti veri (feature Gold); il JSON di valutazione/nome fornitore resta
# comunque piccolo indipendentemente da questo tetto.
MAX_UPLOAD_BYTES=10485760

# Sotto questa soglia, qualunque piano puo' caricare senza controlli extra.
# Sopra, il server verifica on-chain che l'indirizzo abbia un piano che lo
# consente (Gold per i documenti, Silver+ per l'immagine del registro).
FREE_UPLOAD_BYTES=307200
