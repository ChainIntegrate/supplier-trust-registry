# Chiave privata del deployer — paga il gas, NON e' l'owner del contratto
# (l'owner va impostato esplicitamente sotto, come da principio gia'
# consolidato negli altri progetti ChainIntegrate: deployer e identita'
# del contratto sono sempre tenuti separati)
DEPLOYER_PRIVATE_KEY=

LUKSO_TESTNET_RPC_URL=https://rpc.testnet.lukso.network
LUKSO_MAINNET_RPC_URL=https://42.rpc.thirdweb.com/REPLACE_WITH_CLIENT_ID

# UP ChainIntegrate — owner del contratto per la metadata di collezione
# (LSP4Metadata, icona/nome sullo UP Store). Se lasciato vuoto, lo script
# usa il deployer come owner e stampa un avviso: va sempre impostato
# esplicitamente prima di un deploy reale su testnet/mainnet.
CHAININTEGRATE_OWNER_ADDRESS=

# Indirizzo del contratto ChainIntegrate Membership gia' deployato
# (diverso per testnet e mainnet — usare quello coerente con la rete
# di destinazione). Se lasciato vuoto, lo script salta la configurazione
# dei tier e il Registro resta deployato ma nessuno puo' mintare finche'
# non viene collegato manualmente.
MEMBERSHIP_CONTRACT_ADDRESS=
